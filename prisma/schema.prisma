generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String?
  name               String
  phone              String?
  role               Role             @default(MEMBER)
  status             AccountStatus    @default(ACTIVE)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  chapterId          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  gender             Gender?          @default(PREFER_NOT_TO_SAY)
  department         String?
  academicLevel      AcademicLevel?
  position           String?
  avatarUrl          String?
  avatarPublicId     String?
  profileCompletedAt DateTime?
  reports            ActivityReport[]
  auditLogs          AuditLog[]
  acceptedInvite     Invitation?      @relation("AcceptedBy")
  invitations        Invitation[]     @relation("InvitedBy")
  media              MediaAsset[]
  profile            MemberProfile?
  passwordResets     PasswordReset[]
  posts              Post[]
  sessions           Session[]
  chapter            Chapter?         @relation(fields: [chapterId], references: [id])

  @@index([chapterId])
  @@index([role])
  @@index([status])
}

model Chapter {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  institution  String
  city         String
  state        String
  description  String?
  contactEmail String?
  logoUrl      String?
  logoPublicId String?
  status       ChapterStatus    @default(PENDING)
  activatedAt  DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reports      ActivityReport[]
  events       Event[]
  invitations  Invitation[]
  media        MediaAsset[]
  members      MemberProfile[]
  users        User[]

  @@index([status])
  @@index([institution])
  @@index([state])
}

model ChapterApplication {
  id           String            @id @default(cuid())
  institution  String
  proposedName String
  city         String
  state        String
  contactName  String
  contactEmail String
  contactPhone String
  contactRole  String?
  motivation   String
  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime          @default(now())

  @@index([status])
}

model JoinApplication {
  id                 String             @id @default(cuid())
  fullName           String
  email              String
  phone              String
  institution        String
  state              String?
  chapterCode        String?
  department         String?
  academicLevel      AcademicLevel?
  membershipCategory MembershipCategory @default(STUDENT)
  gender             Gender             @default(PREFER_NOT_TO_SAY)
  motivation         String
  consentAt          DateTime?
  status             ApplicationStatus  @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNotes        String?
  createdAt          DateTime           @default(now())

  @@index([status])
  @@index([email])
  @@index([chapterCode])
}

model MemberProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  fullName           String
  memberCode         String             @unique
  institution        String
  chapterId          String
  department         String?
  academicLevel      AcademicLevel?
  gender             Gender             @default(PREFER_NOT_TO_SAY)
  position           String?
  matricNo           String?
  isExecutive        Boolean             @default(false)
  membershipCategory MembershipCategory @default(STUDENT)
  status             AccountStatus      @default(ACTIVE)
  avatarUrl          String?
  avatarPublicId     String?
  registeredAt       DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  chapter            Chapter            @relation(fields: [chapterId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@index([status])
  @@index([membershipCategory])
  @@index([institution])
}

model Invitation {
  id           String           @id @default(cuid())
  email        String
  role         InvitationRole
  chapterId    String?
  code         String           @unique
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdById  String
  acceptedById String?          @unique
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())
  acceptedBy   User?            @relation("AcceptedBy", fields: [acceptedById], references: [id])
  chapter      Chapter?         @relation(fields: [chapterId], references: [id])
  createdBy    User             @relation("InvitedBy", fields: [createdById], references: [id])

  @@index([email])
  @@index([status])
  @@index([chapterId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityReport {
  id            String   @id @default(cuid())
  chapterId     String
  reportedById  String
  title         String
  summary       String
  activityDate  DateTime
  attendeeCount Int?
  createdAt     DateTime @default(now())
  chapter       Chapter  @relation(fields: [chapterId], references: [id])
  reportedBy    User     @relation(fields: [reportedById], references: [id])

  @@index([chapterId])
  @@index([activityDate])
}

model Post {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String
  body          String
  category      PostCategory  @default(NEWS)
  status        ContentStatus @default(DRAFT)
  coverImageUrl String?
  coverPublicId String?
  authorId      String?
  authorName    String
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        User?         @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@index([category])
}

model Event {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String
  startsAt        DateTime
  endsAt          DateTime?
  location        String
  registrationUrl String?
  status          EventStatus @default(DRAFT)
  chapterId       String?
  coverImageUrl   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  videoUrl        String?
  chapter         Chapter?    @relation(fields: [chapterId], references: [id])

  @@index([status, startsAt])
}

model ContactMessage {
  id              String    @id @default(cuid())
  name            String
  email           String
  subject         String
  message         String
  handledAt       DateTime?
  createdAt       DateTime  @default(now())
  submissionToken String?   @unique

  @@index([createdAt])
}

model MediaAsset {
  id         String    @id @default(cuid())
  publicId   String    @unique
  assetId    String?   @unique
  secureUrl  String
  kind       MediaKind @default(IMAGE)
  format     String?
  bytes      Int?
  width      Int?
  height     Int?
  ownerId    String?
  chapterId  String?
  createdAt  DateTime  @default(now())
  caption    String?
  provider   String    @default("UPLOAD")
  providerId String?
  published  Boolean   @default(true)
  sortOrder  Int       @default(0)
  title      String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id])
  owner      User?     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([chapterId])
}

model SiteContent {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  userAgent  String?
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model AcademicYear {
  id        String   @id
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model ChapterKind {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
}

model Institution {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
}

model State {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  AGID_ADMIN
  CHAPTER_ADMIN
  MEMBER
  ALUMNI
  COMM_MANAGER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ChapterStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipCategory {
  STUDENT
  NON_STUDENT
  ALUMNI
}

enum AcademicLevel {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  ND
  HND
  PGD
  MASTERS
  DOCTORATE
  OTHER
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum InvitationRole {
  SUPER_ADMIN
  AGID_ADMIN
  CHAPTER_ADMIN
  COMM_MANAGER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum PostCategory {
  NEWS
  STORY
  ANNOUNCEMENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO
}
