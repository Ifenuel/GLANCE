// GLANCE, Governance, Leadership and National Civic Engagement
// A student leadership and civic engagement initiative of the
// African Governance Institute for Development (AGID).
// Prisma schema (PostgreSQL on Aiven)

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  AGID_ADMIN
  COMM_MANAGER
  CHAPTER_ADMIN
  MEMBER
  ALUMNI
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ChapterStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipCategory {
  STUDENT
  NON_STUDENT
  ALUMNI
}

enum AcademicLevel {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  ND
  HND
  PGD
  MASTERS
  DOCTORATE
  OTHER
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum InvitationRole {
  CHAPTER_ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum PostCategory {
  NEWS
  STORY
  ANNOUNCEMENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?
  name            String
  phone           String?
  role            Role          @default(MEMBER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  // Staff accounts (officer, communication manager, chapter admin) carry their
  // own details here because they have no member record. profileCompletedAt
  // stays null for accounts created by invitation, and the portal forces the
  // person to complete these fields before anything else opens.
  gender              Gender?         @default(PREFER_NOT_TO_SAY)
  department          String?
  academicLevel       AcademicLevel?
  position            String?
  profileCompletedAt  DateTime?
  chapterId       String?
  chapter         Chapter?      @relation(fields: [chapterId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile        MemberProfile?
  sessions       Session[]
  passwordResets PasswordReset[]
  invitations    Invitation[]    @relation("InvitedBy")
  acceptedInvite Invitation?     @relation("AcceptedBy")
  auditLogs      AuditLog[]
  reports        ActivityReport[]
  posts          Post[]
  media          MediaAsset[]

  @@index([chapterId])
  @@index([role])
  @@index([status])
}

model Chapter {
  id            String        @id @default(cuid())
  code          String        @unique // e.g. GLN-UI-001, issued by AGID
  name          String // e.g. "GLANCE Club, University of Ibadan"
  institution   String
  city          String
  state         String
  description   String?
  contactEmail  String?
  logoUrl       String?
  logoPublicId  String?
  status        ChapterStatus @default(PENDING)
  activatedAt   DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users      User[]
  members    MemberProfile[]
  reports    ActivityReport[]
  invitations Invitation[]
  events     Event[]
  media      MediaAsset[]

  @@index([status])
  @@index([institution])
  @@index([state])
}

model ChapterApplication {
  id           String            @id @default(cuid())
  institution  String
  proposedName String
  city         String
  state        String
  contactName  String
  contactEmail String
  contactPhone String
  contactRole  String?
  motivation   String
  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime          @default(now())

  @@index([status])
}

model JoinApplication {
  id            String             @id @default(cuid())
  fullName      String
  email         String
  phone         String
  institution   String
  chapterCode   String?
  department    String?
  academicLevel AcademicLevel?
  membershipCategory MembershipCategory @default(STUDENT)
  gender        Gender             @default(PREFER_NOT_TO_SAY)
  motivation    String
  consentAt     DateTime?
  status        ApplicationStatus  @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime           @default(now())

  @@index([status])
  @@index([email])
  @@index([chapterCode])
}

model MemberProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  memberCode         String             @unique // unique GLANCE member ID, e.g. GLN-2026-A7B3K9
  institution        String
  chapterId          String
  chapter            Chapter            @relation(fields: [chapterId], references: [id])
  department         String?
  academicLevel      AcademicLevel?
  gender             Gender             @default(PREFER_NOT_TO_SAY)
  position           String? // chapter position/executive role, set by admins only
  isExecutive        Boolean            @default(false)
  membershipCategory MembershipCategory @default(STUDENT)
  status             AccountStatus      @default(ACTIVE)
  avatarUrl          String?
  avatarPublicId     String?
  registeredAt       DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([chapterId])
  @@index([status])
  @@index([membershipCategory])
  @@index([institution])
}

model Invitation {
  id           String           @id @default(cuid())
  email        String
  role         InvitationRole
  chapterId    String?
  chapter      Chapter?         @relation(fields: [chapterId], references: [id])
  code         String           @unique // short human-typed activation code, e.g. GLN7KQ2M
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdById  String
  createdBy    User             @relation("InvitedBy", fields: [createdById], references: [id])
  acceptedById String?          @unique
  acceptedBy   User?            @relation("AcceptedBy", fields: [acceptedById], references: [id])
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([email])
  @@index([status])
  @@index([chapterId])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ActivityReport {
  id            String   @id @default(cuid())
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id])
  reportedById  String
  reportedBy    User     @relation(fields: [reportedById], references: [id])
  title         String
  summary       String
  activityDate  DateTime
  attendeeCount Int?
  createdAt     DateTime @default(now())

  @@index([chapterId])
  @@index([activityDate])
}

// ---------------------------------------------------------------------------
// Public content
// ---------------------------------------------------------------------------

model Post {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  body           String
  category       PostCategory  @default(NEWS)
  status         ContentStatus @default(DRAFT)
  coverImageUrl  String?
  coverPublicId  String?
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id])
  authorName     String
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Event {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String
  startsAt        DateTime
  endsAt          DateTime?
  location        String
  registrationUrl String?
  videoUrl        String? // optional teaser/aftermovie link shown on the public page
  status          EventStatus @default(DRAFT)
  chapterId       String?
  chapter         Chapter?    @relation(fields: [chapterId], references: [id])
  coverImageUrl   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, startsAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  // Idempotency key generated by the browser once per form render. A
  // double-click or a retried request repeats the key, so the unique index
  // makes the duplicate impossible to store.
  submissionToken String? @unique
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model MediaAsset {
  id           String    @id @default(cuid())
  publicId     String    @unique
  assetId      String?   @unique
  secureUrl    String
  kind         MediaKind @default(IMAGE)
  /// UPLOAD | YOUTUBE | LINK - how the asset is displayed on the public site.
  provider     String    @default("UPLOAD")
  /// Provider video id (for YouTube) or external id.
  providerId   String?
  title        String?
  caption      String?
  /// Published assets appear in the public gallery; drafts stay in the portal.
  published    Boolean   @default(true)
  sortOrder    Int       @default(0)
  format       String?
  bytes        Int?
  width        Int?
  height       Int?
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id])
  chapterId    String?
  chapter      Chapter?  @relation(fields: [chapterId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([ownerId])
  @@index([chapterId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     String // e.g. "chapter.activate", "member.create", "invitation.issue"
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
